#!/bin/bash
# Optimize glyph fitting from a font character
#
# Usage: ./bin/optimize [options]
#
# Examples:
#   ./bin/optimize
#   ./bin/optimize --char B --n_iter 1000

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
GFOG_DIR="$(dirname "$(dirname "$PROJECT_DIR")")"

export PYTHONPATH="$PROJECT_DIR/src:$GFOG_DIR/src"

exec "$GFOG_DIR/.venv/bin/python" "$PROJECT_DIR/scripts/optimize.py" "$@"
